[Unit]
Description=5GNexusGuard - Decentralized Zero Trust Overlay
Documentation=https://github.com/wpospace/defenderlink-mesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/defenderlink/defenderlink.conf
ExecStart=/opt/defenderlink/bin/defenderlink-mesh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=defenderlink
NoNewPrivileges=false
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
